<style type="text/css">
.template-cv form {
    height: 330px;
}
.background-img-template {
    height: 320px;
    background-size: cover;
    box-shadow: 7px 5px 30px rgba(72,73,121,.15);
    position: relative;
}

.cv-template-color {
    height: 36px;
}
.cv-color {
    padding: 8px 7px;
    display: table;
    float: left;
}
.cv-color a {
    height: 20px;
    width: 20px;
    display: block;
    border-radius: 50%;
    cursor: pointer;
    text-align: center;
    line-height: 20px;
    font-size: 12px;
    border: solid .1px #0000002e;
}
a:not([href]):not([tabindex]) {
    color: inherit;
    text-decoration: none;
}

.dashicons, .dashicons-before:before {
    font-family: dashicons;
    display: inline-block;
    line-height: 1;
    font-weight: 400;
    font-style: normal;
    speak: none;
    text-decoration: inherit;
    text-transform: none;
    text-rendering: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    width: 20px;
    height: 20px;
    font-size: 20px;
    vertical-align: top;
    text-align: center;
    transition: color .1s ease-in;
}
.cv-color a>i.fas, .cv-template-color a>span.dashicons {
    color: #fff;
}
.background-img-template input[type="submit"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    margin-top: 0!important;
}
.background-img-template {
    height: 320px;
    background-size: cover;
    box-shadow: 7px 5px 30px rgba(72,73,121,.15);
    position: relative;
}
@media screen and (min-width: 740px)
.col4 {
    display: table-cell;
    padding: 2%;
    width: 25%;
}
.cv-template-color a>span.dashicons {
    position: relative;
    right: 1px;
}
.background-img-template:hover input[type="submit"] {
    position: absolute;
    background: rgba(42,84,132,.61);
    color: #fff;
    opacity: 1;
    margin-top: 0!important;
    font-family: 'anton_regular',sans-serif;
    letter-spacing: 2px;
    font-size: 22px;
    transition: 0.3s;
}
 input[type="submit"], input[type="submit"] {
    cursor: pointer;
    background: #184979;
}

.css-1vh6i3x {
    max-width: 810px;
    width: 100%;
    margin: 0px auto;
}
.css-b9pwbv {
    font-size: 14px;
    color: rgb(0, 50, 127);
    background-color: rgb(230, 239, 255);
    margin-bottom: 24px;
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    border-color: rgb(179, 209, 255);
    padding: 8px 12px;
}

.css-g50631 {
    background-color:rgb(230, 239, 255);
    display: inline-flex;
    margin-right: 4px;
    vertical-align: text-bottom;
    border-radius: 2px;
}

.css-uzhbcc {
    font-size: 14px;
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.35px;
    line-height: 22px;
    margin-right: 8px;
    color: rgb(77, 97, 130);
}
.css-1xr94rl {
    display: inline;
}
.css-1ez1kl4 {
    display: inline-flex;
    -webkit-box-pack: center;
    justify-content: center;
    -webkit-box-align: center;
    align-items: center;
    text-align: center;
    user-select: none;
    cursor: pointer;
    min-width: 80px;
    color: rgb(255, 255, 255);
    background-color: rgb(0, 85, 217);
    height: 28px;
    min-height: 28px;
    font-size: 14px;
    line-height: 13px;
    border-width: 1px;
    border-style: solid;
    border-color: transparent;
    border-image: initial;
    border-radius: 2px;
    text-decoration: none;
    transition: color 0.2s ease 0s, background-color 0.2s ease 0s, border-color 0.2s ease 0s;
    padding: 0px 8px;
}
.css-2m6wmx {
    font-size: 14px;
    font-weight: 600;
    font-style: normal;
    letter-spacing: -0.35px;
    line-height: 22px;
    color: rgb(0, 20, 51);
}
.css-tjx49 {
    display: inline-flex;
    line-height: 1em;
    width: 21px;
    height: 21px;
}
.css-8qkzbz {
    margin-bottom: 16px;
    padding: 24px;
    background: rgb(255, 255, 255);
    border-width: 1px;
    border-style: solid;
    border-color: rgb(217, 221, 228);
    border-image: initial;
    border-radius: 2px;
}
.pc-improve-profile-container .jobseeker-sidebar__item:first-of-type {
    padding: 0;
} 
.jobseeker-sidebar__item:last-of-type {
    border-bottom: none;
}
.jobseeker-sidebar__item:first-of-type {
    padding-top: 0;
    padding-bottom: 16px;
}

.profile-stats__title {
    font-size: 16px;
    margin-bottom: 8px;
    line-height: 20px;
	    font-weight: bold;
}
.profile-stats__profile-views {
    margin-bottom: 8px;
    line-height: 16px;
}
.profile-stats__profile-views {
    font-style: italic;
    font-size: 12px;
    margin-bottom: 16px;
    color: #808ea5;
}
.progress-bar {
    height: 15px;
    background-color: #d8d8d8;
}

.progress-bar__inner {
    background: #0055d9;
    height: 100%;
}
.profile-stats__profile-strength {
    margin-top: 8px;
    line-height: 16px;
}
.profile-stats__profile-strength {
    margin-top: 16px;
    color: #808ea5;
    font-size: 12px;
}
.css-8qkzbz {
    margin-bottom: 16px;
    padding: 24px;
    background: rgb(255, 255, 255);
    border-width: 1px;
    border-style: solid;
    border-color: rgb(217, 221, 228);
    border-image: initial;
    border-radius: 2px;
	clear: both;
}
.pc-improve-profile-container {
    margin-bottom: 0;
    margin-top: 16px;
}
</style>

{title}[[Edit a {$listingTypeID|escape}]]{/title}

	<!--Back -->

						<div class="container">
								   
							<div class=" text-right">
								{if $url == "/my-resume-details/{$listing.id}/"}
									<a href="{$GLOBALS.site_url}/edit-{$listing.type.id}/?listing_id={$listing.id}"
									   class="btn__back btn__back_resume">
										 &raquo; [[Back]]
									</a>
									{javascript}
										<script type="text/javascript">
											if (window.history && window.history.pushState) {
												window.history.pushState('forward', null, '');
												$(window).on('popstate', function() {
													window.location.href = '{$GLOBALS.site_url}/edit-{$listing.type.id}/?listing_id={$listing.id}';
												});
											}
										</script>
									{/javascript}
								{else}
									{if $backPage && is_numeric($searchID)}
										<a href="{$GLOBALS.site_url}/resumes/?searchID={$searchID}&action=search&listings_per_page={$backPage * 20}#{$listing.id}"
										   class="btn__back btn__back_resume ">
											&laquo; [[Back]]
										</a>
									{else}
										<a href="javascript:history.go(-1)"
										   class="btn__back btn__back_resume">
											&laquo; [[Back]]
										</a>
									{/if}
								{/if}
							</div>
						
						   
						</div>
				
				<!--Back -->

<!-- Menu Vertical Edit CV a gauche-->
<div class=" col-md-3">
<nav class="sidebar">

	<a class="sidebar__list-item {if $currentPage.order == 1}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/Interests/{$listingSID}" aria-current="page">Intérêts Professionnels</a>
		<a class="sidebar__list-item {if $currentPage.order == 2}is-active {/if}"  href="{$GLOBALS.site_url}/edit-resume/General/{$listingSID}">Informations  Générales</a>
	<a class="sidebar__list-item  {if $currentPage.order == 3}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/Professional/{$listingSID}">Informations  Professionnelles</a>
	<a class="sidebar__list-item  {if $currentPage.order == 4}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/Experience/{$listingSID}">Experience </a>
	<a class="sidebar__list-item  {if $currentPage.order == 5}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/Education/{$listingSID}">Education </a>
	<a class="sidebar__list-item  {if $currentPage.order == 6}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/PresenceOnline/{$listingSID}">Présence en ligne </a>
	<a class="sidebar__list-item  {if $currentPage.order == 7}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/Downloads/{$listingSID}">Documents</a>
	<a class="sidebar__list-item  {if $currentPage.order == 8}is-active {/if}" href="{$GLOBALS.site_url}/edit-resume/CVModels/{$listingSID}">Modèle CV Tanitjobs</a>
   <a class="sidebar__list-item  {if $GLOBALS.user_page_uri == '/resume/'}is-active {/if}" href=" {if $GLOBALS.user_page_uri == '/resume/'}#{else}{$GLOBALS.site_url}/resume/{$listingSID}{/if}">Visualiser CV</a>
			
	</nav>

	<div class="pc-improve-profile-container css-8qkzbz e1l5ldaa0" >
	<div class="jobseeker-sidebar__profile-stats profile-stats jobseeker-sidebar__item">
	
	<h3 class="profile-stats__title">Améliorer votre CV</h3>
	<p class="profile-stats__profile-views"><b>{$views}</b> Employeurs ont consulté votre profil au cours des 30 derniers jours</p>
